          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/productos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1,\n  \"nombre\": \"Teclado\",\n  \"descripcion\": \"Teclado mecánico RGB\",\n  \"precio\": 135000,\n  \"stock\": 10\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
