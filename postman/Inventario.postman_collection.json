          "name": "01 Crear producto (201)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/productos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Teclado\",\n  \"descripcion\": \"Teclado mecánico\",\n  \"precio\": 120000,\n  \"stock\": 10\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "02 Crear segundo producto (201)",
