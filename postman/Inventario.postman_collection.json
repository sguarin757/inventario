{
  "info": {
    "name": "Inventario - Spring Boot",
    "description": "Pruebas de la API de inventario. Ejecutar las peticiones en orden, con la base de datos vacía, para que los ids coincidan.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" }
  ],
  "item": [
